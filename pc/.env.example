# Скопируй этот файл в .env и заполни. .env не коммитится.

# Ключ Claude API: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Telegram-бот: создай у @BotFather, токен сюда
TELEGRAM_BOT_TOKEN=
# Твой chat id (узнать у @userinfobot). Бот отвечает только этим id.
TELEGRAM_ALLOWED_CHAT_IDS=

# Android-мост (следующий этап). Адрес телефона в локальной сети или Tailscale.
PHONE_BRIDGE_URL=http://192.168.1.50:8765
# Любая длинная случайная строка, та же самая вписывается в приложении на телефоне
PHONE_BRIDGE_TOKEN=

# Заметки: папка с .md файлами (можно указать папку Obsidian).
# По умолчанию Documents\Friday Notes
NOTES_DIR=

# Почта UVic (Microsoft 365). Как получить MS_CLIENT_ID, см. docs/email-uvic.md.
# После заполнения один раз выполни: python -m jarvis_pc login-email
EMAIL_PROVIDER=microsoft
MS_CLIENT_ID=
MS_TENANT=organizations

# Или другая почта по IMAP/SMTP (тогда EMAIL_PROVIDER оставь пустым).
# Нужен пароль приложения, не основной пароль.
# Gmail: imap.gmail.com / smtp.gmail.com, пароль приложения: https://myaccount.google.com/apppasswords
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_IMAP_HOST=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587

# Twilio: звонки и SMS с твоего Twilio-номера. Каждый звонок/SMS платный,
# поэтому выключено. Поставь 1, чтобы включить (и всё равно каждое действие через /yes).
TWILIO_ENABLED=0
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Трекер целей (папка goals/ в этом репозитории)
GOALS_API_URL=http://localhost:8787
GOALS_API_TOKEN=

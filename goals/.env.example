# Скопируй в .env. Если pc/.env уже заполнен, Telegram-настройки и GOALS_API_TOKEN
# берутся оттуда, и этот файл можно не создавать.

# Длинная случайная строка. Та же самая вводится в приложении на телефоне
# и пишется в pc/.env, чтобы Пятница могла читать и отмечать цели.
GOALS_API_TOKEN=

# 0.0.0.0 = доступно с телефона в той же Wi-Fi сети (или через Tailscale)
GOALS_HOST=0.0.0.0
GOALS_PORT=8787

# Во сколько присылать вечернее напоминание в Telegram (время компьютера)
GOALS_REMIND_AT=21:00

# Те же значения, что в pc/.env (бот Пятницы)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
